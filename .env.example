# Example environment variables for aimac development
# Copy to .env (git ignored) and adjust values as needed.
#
# Note: Variable expansion (${VAR}) requires bash-compatible dotenv loading.
# If expansion fails, set full paths explicitly.

# OpenRouter API key for accessing AI models
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk_your_key_here


# API Collection Execution Settings
# Concurrency for parallel API calls. Looks high, but API calls are I/O-bound.
# We've tested up to 560 safely.
OPENROUTER_CONCURRENCY=50
# Number of retries after the first attempt (4 retries = 5 total attempts)
OPENROUTER_MAX_RETRY_ATTEMPTS=4
# Maximum backoff seconds for exponential retry sleep
OPENROUTER_MAX_BACKOFF_SECONDS=30
# Verbose per-request logging during collection
OPENROUTER_DEBUG_LOGGING=false


# Directory Configuration
# Base directory for all aimac runtime data
AIMAC_DATA_DIR=./data
# Database location (SQLite file). Defaults derive from AIMAC_DATA_DIR; override explicitly if needed.
AIMAC_DATABASE_PATH=${AIMAC_DATA_DIR}/aimac.db
# Log file location
AIMAC_LOG_PATH=${AIMAC_DATA_DIR}/logs/aimac.log


# Database Configuration
# SQLite busy timeout in seconds
AIMAC_DB_TIMEOUT=30


# Logging Configuration
# Log levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
AIMAC_LOG_LEVEL=INFO
# Log format: plain (human-readable) or json (machine-parseable)
AIMAC_LOG_FORMAT=plain


# Report Configuration
# Default report output format: tsv, pretty, or json
AIMAC_REPORT_FORMAT=tsv


# Screenshot Configuration
# Timeouts for Playwright screenshot capture (milliseconds)
SCREENSHOT_TIMEOUT_MS=10000
SCREENSHOT_WAIT_IMAGES_MS=3000
SCREENSHOT_WAIT_FONTS_MS=2000
